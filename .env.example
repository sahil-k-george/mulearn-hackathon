# -----------------------------------------------------------------------------
# Adaptive Academic Companion — environment configuration
#
# Everything here is OPTIONAL. With no .env file the app runs fully:
#   - data is stored in a local JSON file (.data/db.json)
#   - AI runs in deterministic "mock" mode (real extraction, no API key needed)
# -----------------------------------------------------------------------------

# --- AI provider (optional) -------------------------------------------------
# mock | openai | gemini | openrouter | grok. Defaults to mock when no key.
#
# Users can also bring their OWN key + model in the app's Settings page, which
# takes priority over these. These env vars are a deployment-wide default.
AI_PROVIDER=mock

# OpenAI (used when AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when AI_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# OpenRouter — one key for many models (used when AI_PROVIDER=openrouter)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Grok / xAI (used when AI_PROVIDER=grok)
# XAI_API_KEY=
# GROK_MODEL=grok-2-latest

# Public base URL, sent to OpenRouter as the HTTP-Referer attribution header.
APP_URL=http://localhost:3000

# --- Demo mode ---------------------------------------------------------------
# The demo ACCOUNT (the seeded sahil@university.edu user) may always use the
# built-in deterministic engine without a key. Set DEMO_MODE=true to treat the
# whole deployment as a demo (every account may fall back to deterministic).
# Leave unset so real accounts must configure their own key.
# DEMO_MODE=true

# --- Supabase failover (optional) -------------------------------------------
# When set, Supabase becomes the primary store. If Supabase is unreachable,
# the app fails over to the local file store automatically.
#
# Requires a single table (run once in the Supabase SQL editor):
#
#   create table if not exists app_state (
#     key text primary key,
#     value jsonb not null,
#     updated_at timestamptz not null default now()
#   );
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
